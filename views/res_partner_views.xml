<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_ai_segmentation" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.ai</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button name="action_analyze_customer_ai" type="object" class="oe_stat_button" icon="fa-magic" string="AI Phân tích">
                </button>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="ai_segmentation_tag" decoration-bf="1" decoration-info="1"/>
            </xpath>
            
        </field>
    </record>
</odoo>
