<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_ai_forecast" model="ir.ui.view">
        <field name="name">product.template.form.inherit.ai</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_forecast_demand_ai" type="object" string="AI Dự báo Nhu cầu" class="oe_stat_button" icon="fa-line-chart"/>
            </xpath>

            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="ai_restock_suggestion" decoration-bf="1" decoration-danger="1"/>
                <field name="ai_forecast_date" invisible="1"/>
            </xpath>
            
        </field>
    </record>
</odoo>
