<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Tạo Danh mục Sản phẩm -->
        <record id="cat_seafood" model="product.category">
            <field name="name">Hải Sản Tươi Sống</field>
        </record>

        <!-- 2. Cron Job: AI tự động quét hàng cận Date mỗi ngày -->
        <record id="ir_cron_ai_check_expiration" model="ir.cron">
            <field name="name">AI: Tự động Cảnh báo &amp; Phân tích Hàng cận Date</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiration_ai()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
